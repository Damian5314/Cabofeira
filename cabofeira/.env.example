# Copy this file to .env.local and fill in the values from your Supabase project.
# Project Settings → API → Project URL and "anon public" key.
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (CAPTCHA — ABUSE-02). DEFERRED: not yet provisioned.
# Public site key (safe in the client bundle). Get it from Cloudflare Dashboard → Turnstile → add widget.
# Until this is set, the signup/post CAPTCHA is intentionally NOT wired in (see Phase 2 follow-up).
REACT_APP_TURNSTILE_SITE_KEY=
# NOTE: the Turnstile SECRET key is server-only. It MUST NOT be placed here or use a REACT_APP_ prefix.
# It is set via `supabase secrets set CLOUDFLARE_SECRET_KEY=...` and in Supabase Auth → CAPTCHA config.